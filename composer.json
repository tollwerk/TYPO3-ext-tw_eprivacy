{
    "name": "tollwerk/tw-eprivacy",
    "type": "typo3-cms-extension",
    "description": "ePrivacy Consent Manager for TYPO3",
    "license": ["GPL-3.0-or-later"],
    "keywords": [
      "TYPO3",
      "Cookies",
      "Privacy",
      "Consent"
    ],
    "authors": [
        {
            "name": "Joschi Kuphal",
            "email": "joschi@tollwerk.de",
            "homepage": "https://tollwerk.de",
            "role": "Developer"
        },
        {
            "name": "Klaus Fiedler",
            "email": "klaus@tollwerk.de",
            "homepage": "https://tollwerk.de",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/tollwerk/TYPO3-ext-tw_eprivacy",
    "support": {
      "issues": "https://github.com/tollwerk/TYPO3-ext-tw_eprivacy/issues",
      "source": "https://github.com/tollwerk/TYPO3-ext-tw_eprivacy",
      "docs": "https://github.com/tollwerk/TYPO3-ext-tw_eprivacy"
    },
    "require": {
        "typo3/cms-core": "^13"
    },
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwEprivacy\\": "Classes"
        }
    },
    "replace": {
        "tollwerk/tw_eprivacy": "self.version",
        "typo3-ter/tw-eprivacy": "self.version"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tw_eprivacy"
        }
    }
}
